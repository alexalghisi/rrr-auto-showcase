{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://eeaukmjxkiqdybpnuxis.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "bremen-auto",
      "version": "0.1.0",
      "title": "Bremen Auto"
    },
    "tools": [
      {
        "name": "list_cars",
        "title": "List cars",
        "description": "List cars in the Bremen Auto stock, optionally filtered by make or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "make": {
              "description": "Filter by make, e.g. BMW.",
              "type": "string",
              "maxLength": 60
            },
            "status": {
              "description": "Filter by status.",
              "type": "string",
              "enum": [
                "disponibila",
                "rezervata",
                "vanduta"
              ]
            },
            "limit": {
              "description": "Max results (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List recent customer requests (reservations, financing, alerts). Admins only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max results (default 30).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "set_car_status",
        "title": "Set car status",
        "description": "Mark a car as available, reserved or sold (sold hides it from the site). Admins only.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Car slug from list_cars."
            },
            "status": {
              "type": "string",
              "enum": [
                "disponibila",
                "rezervata",
                "vanduta"
              ]
            }
          },
          "required": [
            "slug",
            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
